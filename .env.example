# Copy to .env and fill in. Never commit .env.

# --- Core ---
NODE_ENV=development
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000

# --- Database (PostgreSQL + pgvector, see docker-compose.yml) ---
DATABASE_URL=postgres://allfina:allfina@localhost:5432/allfina

# --- Redis (BullMQ job queues) ---
REDIS_URL=redis://localhost:6379

# --- Auth (Better Auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Public origin the browser talks to (Next.js proxies /api/* to the API)
BETTER_AUTH_URL=http://localhost:3000

# --- Object storage (MinIO locally, S3 in production) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=allfina-recordings
S3_ACCESS_KEY_ID=allfina
S3_SECRET_ACCESS_KEY=allfina-secret
S3_FORCE_PATH_STYLE=true

# --- Internal AI service (Python / FastAPI) ---
AI_SERVICE_URL=http://localhost:8000
# Shared secret between api <-> ai-service. Generate with: openssl rand -hex 32
AI_SERVICE_API_KEY=change-me-internal-key

# --- AI providers (used by apps/ai-service) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
DEEPGRAM_API_KEY=
