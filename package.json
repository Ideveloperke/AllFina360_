{
  "name": "allfina",
  "private": true,
  "description": "AllFina - AI assistant for financial advisors",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @allfina/db db:generate",
    "db:migrate": "pnpm --filter @allfina/db db:migrate",
    "db:studio": "pnpm --filter @allfina/db db:studio",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "services:up": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-services.ps1",
    "services:down": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-services.ps1 -Stop"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "eslint": "^9.33.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0"
  }
}
